# Environment Configuration Template
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment
# WICHTIG: DO NOT commit .env.local or .env.production to git!

# API URLs
# NEXT_PUBLIC_API_URL ist für Frontend→Backend (Next.js API Routes)
# API_URL ist für Backend→Game Server
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:5085

# Keycloak Configuration
KEYCLOAK_ID=student_client
KEYCLOAK_SECRET=your-keycloak-client-secret-here
KEYCLOAK_ISSUER=http://localhost:18080/realms/pixelboard-test
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:18080/realms/pixelboard-test

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here

# Team Name (für automatische Team-Registrierung)
# Für Online Server: NEXT_PUBLIC_TEAM_NAME=JFPW
# Für Lokal: Leer lassen, verwendet dann "Team {nummer}"
NEXT_PUBLIC_TEAM_NAME=

# For Production:
# - Set API_URL=https://edu.jakobmeier.ch
# - Set KEYCLOAK_ISSUER=https://auth.jakobmeier.ch/realms/pixelboard-test
# - Set NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.jakobmeier.ch/realms/pixelboard-test
# - Use production KEYCLOAK_SECRET from instructor
# - Set NEXTAUTH_URL to your deployed app URL
