# Environment Configuration - Production (Remote Server)
# Copy this to .env.production.local and update if needed
# DO NOT commit .env.production.local to git! It's in .gitignore

# Remote API URL (edu.jakobmeier.ch)
NEXT_PUBLIC_API_URL=https://edu.jakobmeier.ch

# Keycloak Configuration - Production (auth.jakobmeier.ch)
KEYCLOAK_ID=student_client
KEYCLOAK_SECRET=42L4oVnt3DK7eNDuiKmBPfPcNC7tF4gv
KEYCLOAK_ISSUER=https://auth.jakobmeier.ch/realms/pixelboard-test

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_YOUR_SECRET

# To generate NEXTAUTH_SECRET, run in PowerShell:
# -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})

# IMPORTANT: 
# - DO NOT commit this file with the real secret to GitHub!
# - Each team member needs to set up their own .env.production.local file
# - You can also use dotnet user-secrets for managing secrets
